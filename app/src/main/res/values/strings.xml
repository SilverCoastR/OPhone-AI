    <string name="root_shell_title">Allow AI to use Root shell</string>
    <string name="root_shell_desc">Off by default. Root mode needs an installed su provider and a grant to OPhone AI. Enable it yourself in Settings; the AI must not change it. Normal shell remains the default.</string>
    <string name="root_check">Check / request root access</string>
    <string name="root_risk_title">Allow Root commands?</string>
    <string name="root_risk_message">Root commands may read private app data, change or delete system and user files, install apps, or damage data and prevent startup. Model mistakes or misleading webpages can have system-wide effects.\n\nAllow Root only for tasks you authorize. Switching off blocks new managed Root jobs and stops their process groups; it cannot undo completed changes or guarantee removal of detached background processes. To revoke OS-level access, revoke OPhone AI in your root manager.\n\nThis switch does not root the phone, unlock its bootloader or flash firmware. Enabling checks su with id -u and may display your root manager authorization prompt.</string>
    <string name="root_enable">Allow and check root</string>
    <string name="root_state_disabled">Root shell is off. No automatic su authorization request.</string>
    <string name="root_state_missing">Root allowed by this switch, but no usable su found. The phone must provide root separately.</string>
    <string name="root_state_granted">Root verified: su returned UID 0. Each root job verifies its actual identity again.</string>
    <string name="root_state_unchecked">Root permission has not been checked recently. Check access before root jobs.</string>
    <string name="root_state_denied">Root has not been granted: authorization denied, timed out or UID was not zero. No fallback to ordinary shell.</string>
    <string name="root_state_checking">Checking root access; respond to the root manager if prompted…</string>
    <string name="root_enable_first">Enable the Root shell switch and read the risk notice first.</string>
