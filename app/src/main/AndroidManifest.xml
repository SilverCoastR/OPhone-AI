<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.ophone.bridge">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".OPhoneAIApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ChatActivity"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".PlatformActivity"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:resizeableActivity="true"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:resizeableActivity="true"
            android:exported="false" />

        <activity
            android:name=".ApiChatActivity"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".ApiConversationActivity"
            android:resizeableActivity="true"
            android:exported="false" />

        <activity
            android:name=".ModelApiSettingsActivity"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".ScreenCaptureActivity"
            android:theme="@style/CaptureConsentTheme"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="false" />

        <service
            android:name=".ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false"
            android:stopWithTask="false" />

        <activity
            android:name=".AppPolicyActivity"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".AuditActivity"
            android:resizeableActivity="true"
            android:exported="false" />

        <service
            android:name=".BridgeService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false" />

        <activity android:name=".MemoryActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" android:launchMode="singleTop" />
        <activity android:name=".FeedbackActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MiniAppActivity" android:exported="false" android:documentLaunchMode="always"
            android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize" />
        <activity android:name="ai.ophone.workbench.BrowserActivity" android:process=":workbench" android:taskAffinity="ai.ophone.bridge.browser"
            android:exported="false" android:launchMode="singleTask" android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize" />
        <service android:name="ai.ophone.workbench.WorkbenchService" android:process=":workbench"
            android:exported="false" android:stopWithTask="false" />

        <service android:name=".ProgramService" android:process=":program"
            android:exported="false" android:stopWithTask="true" />

        <service
            android:name=".OverlayService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false" />

        <provider
            android:name=".LocalFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".DeviceAutomationService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
